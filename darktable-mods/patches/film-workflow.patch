diff --git a/src/libs/film_roll.c b/src/libs/film_roll.c
new file mode 100644
index 0000000..4957731
--- /dev/null
+++ b/src/libs/film_roll.c
@@ -0,0 +1,287 @@
+/*
+    This file is part of darktable,
+    Copyright (C) 2026 darktable developers.
+
+    darktable is free software: you can redistribute it and/or modify
+    it under the terms of the GNU General Public License as published by
+    the Free Software Foundation, either version 3 of the License, or
+    (at your option) any later version.
+*/
+
+#include "bauhaus/bauhaus.h"
+#include "common/act_on.h"
+#include "common/collection.h"
+#include "common/darktable.h"
+#include "common/film_roll_workflow.h"
+#include "common/history_snapshot.h"
+#include "common/image.h"
+#include "common/image_cache.h"
+#include "common/mipmap_cache.h"
+#include "common/tags.h"
+#include "common/undo.h"
+#include "control/control.h"
+#include "control/jobs.h"
+#include "gui/accelerators.h"
+#include "gui/gtk.h"
+#include "libs/lib.h"
+#include "libs/lib_api.h"
+
+#include <gtk/gtk.h>
+
+#define FILM_ROLL_PROXY_DIMENSION 1600
+
+DT_MODULE(1)
+
+typedef struct dt_lib_film_roll_t
+{
+  GtkWidget *stock;
+  GtkWidget *process;
+  GtkWidget *status;
+  gint running;
+} dt_lib_film_roll_t;
+
+typedef struct dt_film_roll_job_t
+{
+  GList *images;
+  dt_film_stock_t stock;
+  GtkWidget *button;
+  GtkWidget *status;
+  gint *running;
+} dt_film_roll_job_t;
+
+typedef struct dt_film_roll_completion_t
+{
+  GtkWidget *button;
+  GtkWidget *status;
+  gint *running;
+  gchar *message;
+} dt_film_roll_completion_t;
+
+const char *name(dt_lib_module_t *self)
+{
+  return _("film roll");
+}
+
+const char *description(dt_lib_module_t *self)
+{
+  return _("analyze selected negative scans as one roll and write shared Negadoctor history");
+}
+
+dt_view_type_flags_t views(dt_lib_module_t *self)
+{
+  return DT_VIEW_LIGHTTABLE;
+}
+
+uint32_t container(dt_lib_module_t *self)
+{
+  return DT_UI_CONTAINER_PANEL_RIGHT_CENTER;
+}
+
+int position(const dt_lib_module_t *self)
+{
+  return 705;
+}
+
+static gboolean _job_complete_idle(gpointer user_data)
+{
+  dt_film_roll_completion_t *const completion = user_data;
+  gtk_label_set_text(GTK_LABEL(completion->status), completion->message);
+  gtk_widget_set_sensitive(completion->button, TRUE);
+  g_atomic_int_set(completion->running, 0);
+  g_object_unref(completion->button);
+  g_object_unref(completion->status);
+  g_free(completion->message);
+  g_free(completion);
+  return G_SOURCE_REMOVE;
+}
+
+static void _schedule_completion(dt_film_roll_job_t *const data,
+                                 const gchar *const message)
+{
+  dt_film_roll_completion_t *const completion = g_new0(dt_film_roll_completion_t, 1);
+  completion->button = g_object_ref(data->button);
+  completion->status = g_object_ref(data->status);
+  completion->running = data->running;
+  completion->message = g_strdup(message);
+  gdk_threads_add_idle(_job_complete_idle, completion);
+}
+
+static int32_t _film_roll_job_run(dt_job_t *job)
+{
+  dt_film_roll_job_t *const data = dt_control_job_get_params(job);
+  const size_t requested = g_list_length(data->images);
+  dt_imgid_t *const image_ids = g_new(dt_imgid_t, requested);
+  dt_film_analysis_result_t *const frames = g_new0(dt_film_analysis_result_t, requested);
+  size_t analyzed = 0;
+  size_t failed = 0;
+  const double started = dt_get_wtime();
+
+  dt_control_job_set_progress_message(job,
+                                      ngettext("analyzing %zu negative",
+                                               "analyzing %zu negatives", requested),
+                                      requested);
+  size_t index = 0;
+  for(GList *item = data->images; item; item = g_list_next(item), index++)
+  {
+    if(dt_control_job_get_state(job) == DT_JOB_STATE_CANCELLED) break;
+    const dt_imgid_t imgid = GPOINTER_TO_INT(item->data);
+    dt_film_analysis_result_t frame;
+    if(dt_film_analyze_image_proxy(imgid, data->stock,
+                                   FILM_ROLL_PROXY_DIMENSION, &frame) == 0)
+    {
+      image_ids[analyzed] = imgid;
+      frames[analyzed++] = frame;
+    }
+    else
+      failed++;
+    dt_control_job_set_progress(job, 0.75 * (double)(index + 1) / requested);
+  }
+  const double analysis_seconds = dt_get_wtime() - started;
+
+  dt_film_roll_analysis_result_t roll;
+  if(analyzed == 0 || dt_film_analyze_roll(frames, analyzed, NULL, NULL, &roll) != 0)
+  {
+    const gchar *const message = _("film roll analysis failed: no usable frames");
+    dt_control_log("%s", message);
+    _schedule_completion(data, message);
+    g_free(frames);
+    g_free(image_ids);
+    return 1;
+  }
+
+  const double history_started = dt_get_wtime();
+  size_t written = 0;
+  GList *updated = NULL;
+  dt_undo_start_group(darktable.undo, DT_UNDO_LT_HISTORY);
+  for(size_t frame_index = 0; frame_index < analyzed; frame_index++)
+  {
+    if(dt_control_job_get_state(job) == DT_JOB_STATE_CANCELLED) break;
+    const dt_imgid_t imgid = image_ids[frame_index];
+    dt_undo_lt_history_t *const undo = dt_history_snapshot_item_init();
+    undo->imgid = imgid;
+    dt_history_snapshot_undo_create(imgid, &undo->before, &undo->before_history_end);
+    if(dt_film_write_roll_history(imgid, data->stock, &frames[frame_index], &roll) == 0)
+    {
+      dt_history_snapshot_undo_create(imgid, &undo->after, &undo->after_history_end);
+      dt_undo_record(darktable.undo, NULL, DT_UNDO_LT_HISTORY, (dt_undo_data_t)undo,
+                     dt_history_snapshot_undo_pop,
+                     dt_history_snapshot_undo_lt_history_data_free);
+      updated = g_list_prepend(updated, GINT_TO_POINTER(imgid));
+      dt_image_cache_set_change_timestamp(imgid);
+      dt_mipmap_cache_remove(imgid);
+      DT_CONTROL_SIGNAL_RAISE(DT_SIGNAL_DEVELOP_MIPMAP_UPDATED, imgid);
+      written++;
+    }
+    else
+    {
+      dt_history_snapshot_undo_lt_history_data_free(undo);
+      failed++;
+    }
+    dt_control_job_set_progress(job,
+                                0.75 + 0.25 * (double)(frame_index + 1) / analyzed);
+  }
+  dt_undo_end_group(darktable.undo);
+  const double history_seconds = dt_get_wtime() - history_started;
+
+  if(updated)
+  {
+    guint tagid = 0;
+    dt_tag_new("darktable|changed", &tagid);
+    for(GList *item = updated; item; item = g_list_next(item))
+      dt_tag_attach(tagid, GPOINTER_TO_INT(item->data), FALSE, FALSE);
+    dt_image_synch_xmps(updated);
+    dt_collection_update_query(darktable.collection,
+                               DT_COLLECTION_CHANGE_RELOAD,
+                               DT_COLLECTION_PROP_UNDEF,
+                               g_list_copy(updated));
+    g_list_free(updated);
+  }
+  dt_control_queue_redraw_center();
+
+  const double total_seconds = dt_get_wtime() - started;
+  gchar *const message = g_strdup_printf(
+    _("roll: %zu/%zu histories written in %.1f s (analysis %.1f s, history %.1f s)%s"),
+    written, requested, total_seconds, analysis_seconds, history_seconds,
+    failed ? _(" · some frames failed") : "");
+  dt_control_log("%s", message);
+  _schedule_completion(data, message);
+  g_free(message);
+  g_free(frames);
+  g_free(image_ids);
+  return written == requested ? 0 : 1;
+}
+
+static void _film_roll_job_cleanup(void *user_data)
+{
+  dt_film_roll_job_t *const data = user_data;
+  g_list_free(data->images);
+  g_free(data);
+}
+
+static void _process_clicked(GtkButton *button, dt_lib_module_t *self)
+{
+  dt_lib_film_roll_t *const gui = self->data;
+  if(!g_atomic_int_compare_and_exchange(&gui->running, 0, 1)) return;
+
+  GList *const images = dt_act_on_get_images(TRUE, TRUE, FALSE);
+  if(!images)
+  {
+    g_atomic_int_set(&gui->running, 0);
+    gtk_label_set_text(GTK_LABEL(gui->status), _("select images from one roll first"));
+    return;
+  }
+
+  dt_film_roll_job_t *const data = g_new0(dt_film_roll_job_t, 1);
+  data->images = images;
+  data->stock = dt_bauhaus_combobox_get(gui->stock) == 1
+                  ? DT_FILM_STOCK_MONOCHROME
+                  : DT_FILM_STOCK_COLOR;
+  data->button = gui->process;
+  data->status = gui->status;
+  data->running = &gui->running;
+
+  gtk_widget_set_sensitive(gui->process, FALSE);
+  gtk_label_set_text(GTK_LABEL(gui->status), _("queued…"));
+  dt_job_t *const job = dt_control_job_create(_film_roll_job_run, "film roll analysis");
+  dt_control_job_set_params(job, data, _film_roll_job_cleanup);
+  dt_control_job_add_progress(job, _("film roll analysis"), TRUE);
+  dt_control_add_job(DT_JOB_QUEUE_USER_BG, job);
+}
+
+void gui_init(dt_lib_module_t *self)
+{
+  dt_lib_film_roll_t *const gui = g_new0(dt_lib_film_roll_t, 1);
+  self->data = gui;
+  self->widget = dt_gui_vbox();
+
+  gui->stock = dt_bauhaus_combobox_new(NULL);
+  dt_bauhaus_widget_set_label(gui->stock, NULL, N_("film type"));
+  dt_bauhaus_combobox_add(gui->stock, _("color negative"));
+  dt_bauhaus_combobox_add(gui->stock, _("black and white negative"));
+  dt_bauhaus_combobox_set(gui->stock, 0);
+
+  gui->process = gtk_button_new_with_label(_("analyze selected roll"));
+  gtk_widget_set_tooltip_text(
+    gui->process,
+    _("analyze selected images together and append shared Negadoctor settings to each history"));
+  dt_action_define(DT_ACTION(self), NULL, N_("analyze selected roll"),
+                   gui->process, &dt_action_def_button);
+  g_signal_connect(G_OBJECT(gui->process), "clicked", G_CALLBACK(_process_clicked), self);
+
+  gui->status = gtk_label_new(_("select scans from exactly one roll"));
+  gtk_label_set_xalign(GTK_LABEL(gui->status), 0.0f);
+  gtk_label_set_line_wrap(GTK_LABEL(gui->status), TRUE);
+  dt_gui_box_add(self->widget, gui->stock, gui->process, gui->status);
+}
+
+void gui_cleanup(dt_lib_module_t *self)
+{
+  g_free(self->data);
+  self->data = NULL;
+}
