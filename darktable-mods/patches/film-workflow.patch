+
+#include "common/film_analysis.h"
+
+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define DT_FILM_HISTOGRAM_BINS 4096u
+#define DT_FILM_EPSILON 1.0e-8f
+
+static float _clampf(const float value, const float low, const float high)
+{
+  return value < low ? low : (value > high ? high : value);
+}
+
+static size_t _sample_step(const size_t width, const size_t height, const size_t limit)
+{
+  if(limit == 0 || width == 0 || height == 0) return 1;
+  const double ratio = (double)width * (double)height / (double)limit;
+  return ratio > 1.0 ? (size_t)ceil(sqrt(ratio)) : 1;
+}
+
+static float _histogram_quantile(const uint32_t *histogram,
+                                 const size_t bins,
+                                 const size_t count,
+                                 const float percentile,
+                                 const float maximum)
+{
+  if(count == 0) return 0.0f;
+  const size_t target = (size_t)floor(_clampf(percentile, 0.0f, 1.0f) * (float)(count - 1));
+  size_t seen = 0;
+  for(size_t bin = 0; bin < bins; bin++)
+  {
+    seen += histogram[bin];
+    if(seen > target) return maximum * ((float)bin + 0.5f) / (float)bins;
+  }
+  return maximum;
+}
+
+static void _add_histogram_sample(uint32_t *histogram, const float value, const float maximum)
+{
+  const float normalized = _clampf(value / maximum, 0.0f, 1.0f);
+  const size_t bin = (size_t)fminf(floorf(normalized * DT_FILM_HISTOGRAM_BINS),
+                                  (float)(DT_FILM_HISTOGRAM_BINS - 1));
+  histogram[bin]++;
+}
+
+dt_film_analysis_config_t dt_film_analysis_default_config(const dt_film_stock_t stock)
+{
+  return (dt_film_analysis_config_t){
+    .stock = stock,
+    .border_fraction = 0.08f,
+    .base_percentile = 0.95f,
+    .density_floor_percentile = 0.005f,
+    .density_ceiling_percentile = 0.995f,
+    .maximum_density = 6.0f,
+    .input_ceiling = 0.0f,
+    .sample_limit = 1000000,
+  };
+}
+
+static int _analyze_f32(const float *const rgb,
+                        const size_t width,
+                        const size_t height,
+                        const size_t row_stride,
+                        const size_t pixel_stride,
+                        const dt_film_analysis_config_t *const config,
+                        dt_film_analysis_result_t *const result)
+{
+  if(!rgb || !config || !result || width < 8 || height < 8 || pixel_stride < 3
+     || row_stride < width * pixel_stride
+     || config->maximum_density <= 0.0f)
+    return -1;
+
+  memset(result, 0, sizeof(*result));
+
+  uint32_t *const base_histogram = calloc(3 * DT_FILM_HISTOGRAM_BINS, sizeof(uint32_t));
+  uint32_t *const global_histogram = calloc(3 * DT_FILM_HISTOGRAM_BINS, sizeof(uint32_t));
+  uint32_t *const density_histogram = calloc(3 * DT_FILM_HISTOGRAM_BINS, sizeof(uint32_t));
+  if(!base_histogram || !global_histogram || !density_histogram)
+  {
+    free(base_histogram);
+    free(global_histogram);
+    free(density_histogram);
+    return -2;
+  }
+
+  const size_t step = _sample_step(width, height, config->sample_limit);
+  const float border_fraction = _clampf(config->border_fraction, 0.01f, 0.45f);
+  const size_t border_x = (size_t)fmaxf(1.0f, floorf((float)width * border_fraction));
+  const size_t border_y = (size_t)fmaxf(1.0f, floorf((float)height * border_fraction));
+  float observed_maximum[3] = { DT_FILM_EPSILON, DT_FILM_EPSILON, DT_FILM_EPSILON };
+  double border_sum[3] = { 0.0, 0.0, 0.0 };
+  double border_sum_squared[3] = { 0.0, 0.0, 0.0 };
+
+  /* First pass: obtain a scale. */
+  size_t global_samples = 0;
+  for(size_t y = 0; y < height; y += step)
+  {
+    const float *const row = rgb + y * row_stride;
+    for(size_t x = 0; x < width; x += step)
+    {
+      const float *const pixel = row + pixel_stride * x;
+      for(size_t channel = 0; channel < 3; channel++)
+        if(isfinite(pixel[channel]) && pixel[channel] > observed_maximum[channel])
+          observed_maximum[channel] = pixel[channel];
+    }
+  }
+
+  for(size_t y = 0; y < height; y += step)
+  {
+    const float *const row = rgb + y * row_stride;
+    for(size_t x = 0; x < width; x += step)
+    {
+      const float *const pixel = row + pixel_stride * x;
+      int valid = 1;
+      for(size_t channel = 0; channel < 3; channel++)
+        valid &= isfinite(pixel[channel]) && pixel[channel] > DT_FILM_EPSILON;
+      if(!valid) continue;
+
+      for(size_t channel = 0; channel < 3; channel++)
+        _add_histogram_sample(global_histogram + channel * DT_FILM_HISTOGRAM_BINS,
+                              pixel[channel], observed_maximum[channel]);
+      global_samples++;
+
+      if(x < border_x || x >= width - border_x || y < border_y || y >= height - border_y)
+      {
+        for(size_t channel = 0; channel < 3; channel++)
+        {
+          _add_histogram_sample(base_histogram + channel * DT_FILM_HISTOGRAM_BINS,
+                                pixel[channel], observed_maximum[channel]);
+          border_sum[channel] += pixel[channel];
+          border_sum_squared[channel] += (double)pixel[channel] * pixel[channel];
+        }
+        result->sampled_border_pixels++;
+      }
+    }
+  }
+
+  if(result->sampled_border_pixels < 32)
+  {
+    free(base_histogram);
+    free(global_histogram);
+    free(density_histogram);
+    return -3;
+  }
+
+  float border_base[3], global_base[3];
+  float border_to_global = 0.0f;
+  for(size_t channel = 0; channel < 3; channel++)
+  {
+    border_base[channel] = _histogram_quantile(
+      base_histogram + channel * DT_FILM_HISTOGRAM_BINS,
+      DT_FILM_HISTOGRAM_BINS,
+      result->sampled_border_pixels,
+      config->base_percentile,
+      observed_maximum[channel]);
+    global_base[channel] = _histogram_quantile(
+      global_histogram + channel * DT_FILM_HISTOGRAM_BINS,
+      DT_FILM_HISTOGRAM_BINS,
+      global_samples,
+      0.98f,
+      observed_maximum[channel]);
+    border_to_global += border_base[channel] / fmaxf(global_base[channel], DT_FILM_EPSILON);
+  }
+  border_to_global /= 3.0f;
+  const int use_global_base = border_to_global < 0.55f;
+  for(size_t channel = 0; channel < 3; channel++)
+    result->film_base[channel] = use_global_base ? global_base[channel] : border_base[channel];
+  if(use_global_base) result->warnings |= DT_FILM_ANALYSIS_WARNING_NO_REBATE;
+  result->film_base[3] = 1.0f;
+
+  float relative_border_spread = 0.0f;
+  for(size_t channel = 0; channel < 3; channel++)
+  {
+    const double mean = border_sum[channel] / (double)result->sampled_border_pixels;
+    const double variance = fmax(0.0, border_sum_squared[channel]
+                                      / (double)result->sampled_border_pixels - mean * mean);
+    relative_border_spread += sqrtf((float)variance)
+                              / fmaxf(result->film_base[channel], DT_FILM_EPSILON);
+  }
+  if(relative_border_spread / 3.0f > 0.25f)
+    result->warnings |= DT_FILM_ANALYSIS_WARNING_NONUNIFORM_REBATE;
+
+  /* Second pass: measure density only inside the analysis crop. */
+  for(size_t y = border_y; y < height - border_y; y += step)
+  {
+    const float *const row = rgb + y * row_stride;
+    for(size_t x = border_x; x < width - border_x; x += step)
+    {
+      const float *const pixel = row + pixel_stride * x;
+      int valid = 1;
+      for(size_t channel = 0; channel < 3; channel++)
+        valid &= isfinite(pixel[channel]) && pixel[channel] > DT_FILM_EPSILON;
+      if(!valid) continue;
+
+      for(size_t channel = 0; channel < 3; channel++)
+      {
+        const float density = _clampf(log10f(result->film_base[channel]
+                                             / fmaxf(pixel[channel], DT_FILM_EPSILON)),
+                                      0.0f, config->maximum_density);
+        _add_histogram_sample(density_histogram + channel * DT_FILM_HISTOGRAM_BINS,
+                              density, config->maximum_density);
+      }
+      result->sampled_pixels++;
+    }
+  }
+
+  if(result->sampled_pixels < 32)
+  {
+    free(base_histogram);
+    free(global_histogram);
+    free(density_histogram);
+    return -4;
+  }
+
+  float range_sum = 0.0f;
+  for(size_t channel = 0; channel < 3; channel++)
+  {
+    const uint32_t *const histogram = density_histogram + channel * DT_FILM_HISTOGRAM_BINS;
+    result->density_floor[channel] = _histogram_quantile(histogram, DT_FILM_HISTOGRAM_BINS,
+                                                         result->sampled_pixels,
+                                                         config->density_floor_percentile,
+                                                         config->maximum_density);
+    result->density_median[channel] = _histogram_quantile(histogram, DT_FILM_HISTOGRAM_BINS,
+                                                          result->sampled_pixels, 0.5f,
+                                                          config->maximum_density);
+    result->density_ceiling[channel] = _histogram_quantile(histogram, DT_FILM_HISTOGRAM_BINS,
+                                                           result->sampled_pixels,
+                                                           config->density_ceiling_percentile,
+                                                           config->maximum_density);
+    range_sum += result->density_ceiling[channel] - result->density_floor[channel];
+  }
+
+  result->negadoctor_dmax = fmaxf(range_sum / 3.0f, 0.1f);
+  float floor_sum = 0.0f;
+  for(size_t channel = 0; channel < 3; channel++)
+  {
+    const float range = fmaxf(result->density_ceiling[channel]
+                              - result->density_floor[channel], 0.1f);
+    result->negadoctor_wb_high[channel] = result->negadoctor_dmax / range;
+    floor_sum += result->density_floor[channel];
+  }
+  result->negadoctor_wb_high[3] = 1.0f;
+  result->negadoctor_offset = (floor_sum / 3.0f) / result->negadoctor_dmax;
+
+  const float minimum_range = fminf(result->density_ceiling[0] - result->density_floor[0],
+                                    fminf(result->density_ceiling[1] - result->density_floor[1],
+                                          result->density_ceiling[2] - result->density_floor[2]));
+  if(minimum_range < 0.15f) result->warnings |= DT_FILM_ANALYSIS_WARNING_LOW_RANGE;
+
+  const float border_coverage = fminf((float)result->sampled_border_pixels / 5000.0f, 1.0f);
+  const float range_quality = _clampf(minimum_range / 1.0f, 0.0f, 1.0f);
+  result->confidence = 0.35f * border_coverage + 0.65f * range_quality;
+
+  /* Film base should normally be the brightest part of the image, so it cannot
+   * be diagnosed as clipped from the observed frame maximum. Only callers
+   * with a known representation ceiling may request this warning. */
+  if(config->input_ceiling > 0.0f)
+    for(size_t channel = 0; channel < 3; channel++)
+      if(result->film_base[channel] >= config->input_ceiling * 0.995f)
+        result->warnings |= DT_FILM_ANALYSIS_WARNING_CLIPPED_BASE;
+
+  free(base_histogram);
+  free(global_histogram);
+  free(density_histogram);
+  return 0;
+}
+
+int dt_film_analyze_rgb_f32(const float *const rgb,
+                            const size_t width,
+                            const size_t height,
+                            const size_t row_stride,
+                            const dt_film_analysis_config_t *const config,
+                            dt_film_analysis_result_t *const result)
+{
+  return _analyze_f32(rgb, width, height, row_stride, 3, config, result);
+}
+
+int dt_film_analyze_rgba_f32(const float *const rgba,
+                             const size_t width,
+                             const size_t height,
+                             const size_t row_stride,
+                             const dt_film_analysis_config_t *const config,
+                             dt_film_analysis_result_t *const result)
+{
+  return _analyze_f32(rgba, width, height, row_stride, 4, config, result);
+}
+
+void dt_film_apply_auto_negadoctor_pixel(const float input[3],
+                                         const dt_film_analysis_result_t *const analysis,
+                                         float output[3])
+{
+  if(!input || !analysis || !output) return;
+  for(size_t channel = 0; channel < 3; channel++)
+  {
+    const float density = log10f(fmaxf(input[channel], DT_FILM_EPSILON)
+                                 / fmaxf(analysis->film_base[channel], DT_FILM_EPSILON));
+    const float corrected = analysis->negadoctor_wb_high[channel]
+                            / fmaxf(analysis->negadoctor_dmax, 0.1f) * density
+                            + analysis->negadoctor_offset;
+    output[channel] = _clampf(1.0f - powf(10.0f, corrected), 0.0f, 1.0f);
+  }
+}
+
