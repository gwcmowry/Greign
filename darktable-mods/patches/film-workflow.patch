@@ -0,0 +1,76 @@
+/*
+    This file is part of darktable,
+    Copyright (C) 2026 darktable developers.
+
+    darktable is free software: you can redistribute it and/or modify
+    it under the terms of the GNU General Public License as published by
+    the Free Software Foundation, either version 3 of the License, or
+    (at your option) any later version.
+*/
+
+#pragma once
+
+#include "common/film_analysis.h"
+
+#include <stddef.h>
+#include <stdint.h>
+
+typedef enum dt_film_base_mode_t
+{
+  DT_FILM_BASE_EXPLICIT_REFERENCE = 0,
+  DT_FILM_BASE_MEASURED_REBATE = 1,
+  DT_FILM_BASE_INFERRED_ROLL = 2,
+  DT_FILM_BASE_BORROWED_PRIOR = 3,
+  DT_FILM_BASE_PER_FRAME_FALLBACK = 4
+} dt_film_base_mode_t;
+
+typedef enum dt_film_roll_warning_t
+{
+  DT_FILM_ROLL_WARNING_NONE = 0,
+  DT_FILM_ROLL_WARNING_BASE_INFERRED = 1u << 0,
+  DT_FILM_ROLL_WARNING_BASE_BORROWED = 1u << 1,
+  DT_FILM_ROLL_WARNING_SINGLE_FRAME = 1u << 2,
+  DT_FILM_ROLL_WARNING_REJECTED_FRAMES = 1u << 3
+} dt_film_roll_warning_t;
+
+typedef struct dt_film_base_prior_t
+{
+  float film_base[4];
+  float confidence;
+} dt_film_base_prior_t;
+
+typedef struct dt_film_roll_analysis_result_t
+{
+  dt_film_base_mode_t base_mode;
+  float film_base[4];
+  float density_floor[4];
+  float density_median[4];
+  float density_ceiling[4];
+  float negadoctor_dmax;
+  float negadoctor_wb_high[4];
+  float base_confidence;
+  float roll_confidence;
+  size_t frame_count;
+  size_t frames_used;
+  size_t frames_rejected;
+  uint32_t warnings;
+} dt_film_roll_analysis_result_t;
+
+/*
+ * Aggregate immutable per-frame measurements into a roll baseline.
+ *
+ * `explicit_base` may point to four measured channel values from any clean
+ * rebate patch or dedicated base capture. `borrowed_prior` is optional and is
+ * used only when the roll itself cannot support inference. Neither is required.
+ */
+int dt_film_analyze_roll(const dt_film_analysis_result_t *frames,
+                         size_t frame_count,
+                         const float explicit_base[4],
+                         const dt_film_base_prior_t *borrowed_prior,
+                         dt_film_roll_analysis_result_t *result);
+
+/* Apply shared roll color/range statistics while retaining the frame's mean
+ * luminance placement. `frame` and `result` may point to the same object. */
+int dt_film_apply_roll_baseline(const dt_film_analysis_result_t *frame,
+                                const dt_film_roll_analysis_result_t *roll,
+                                dt_film_analysis_result_t *result);
diff --git a/src/common/film_roll_workflow.c b/src/common/film_roll_workflow.c
new file mode 100644
index 0000000..aea5947
--- /dev/null
+++ b/src/common/film_roll_workflow.c
@@ -0,0 +1,184 @@
+/*
+    This file is part of darktable,
+    Copyright (C) 2026 darktable developers.
+
+    darktable is free software: you can redistribute it and/or modify
+    it under the terms of the GNU General Public License as published by
+    the Free Software Foundation, either version 3 of the License, or
+    (at your option) any later version.
+*/
+
+#include "common/film_roll_workflow.h"
+
+#include "common/image.h"
+#include "common/iop_order.h"
+#include "common/mipmap_cache.h"
+#include "develop/develop.h"
+#include "develop/imageop.h"
+#include "develop/pixelpipe.h"
+
+#include <math.h>
+#include <stdint.h>
+#include <string.h>
+
+/* Stable Negadoctor v2 history wire layout. Keep this local to the history
+ * bridge: the plugin's introspected parameter struct remains its authority. */
+typedef struct dt_film_negadoctor_params_v2_t
+{
+  int32_t film_stock;
+  float Dmin[4];
+  float wb_high[4];
+  float wb_low[4];
+  float D_max;
+  float offset;
+  float black;
+  float gamma;
+  float soft_clip;
+  float exposure;
+} dt_film_negadoctor_params_v2_t;
+
+_Static_assert(sizeof(dt_film_negadoctor_params_v2_t) == 76,
+               "unexpected Negadoctor v2 parameter layout");
+
+int dt_film_analyze_image_proxy(const dt_imgid_t imgid,
+                                const dt_film_stock_t stock,
+                                const int maximum_dimension,
+                                dt_film_analysis_result_t *const result)
+{
+  if(!dt_is_valid_imgid(imgid) || maximum_dimension < 256 || !result) return -1;
+
+  int status = -2;
+  dt_develop_t dev;
+  dt_dev_init(&dev, FALSE);
+  dt_dev_load_image(&dev, imgid);
+
+  dt_mipmap_buffer_t buffer;
+  dt_mipmap_cache_get(&buffer, imgid, DT_MIPMAP_F, DT_MIPMAP_BLOCKING, 'r');
+  if(!buffer.buf || !buffer.width || !buffer.height) goto cleanup_dev;
+
+  const int input_width = buffer.width;
+  const int input_height = buffer.height;
+  dt_dev_pixelpipe_t pipe;
+  if(!dt_dev_pixelpipe_init_export(&pipe, input_width, input_height, IMAGEIO_FLOAT, FALSE))
+  {
+    status = -3;
+    goto cleanup_buffer;
+  }
+
+  dt_ioppr_resync_modules_order(&dev);
+  dt_dev_pixelpipe_set_input(&pipe, &dev, (float *)buffer.buf,
+                             input_width, input_height, buffer.iscale);
+  dt_dev_pixelpipe_create_nodes(&pipe, &dev);
+  dt_dev_pixelpipe_synch_all(&pipe, &dev);
+  if(!pipe.nodes)
+  {
+    status = -4;
+    goto cleanup_pipe;
+  }
+
+  dt_dev_pixelpipe_disable_after(&pipe, "negadoctor");
+  gboolean found_negadoctor = FALSE;
+  for(GList *node = pipe.nodes; node; node = g_list_next(node))
+  {
+    dt_dev_pixelpipe_iop_t *const piece = node->data;
+    if(dt_iop_module_is(piece->module, "negadoctor"))
+    {
+      piece->enabled = FALSE;
+      found_negadoctor = TRUE;
+    }
+  }
+  if(!found_negadoctor)
+  {
+    status = -5;
+    goto cleanup_pipe;
+  }
+
+  dt_dev_pixelpipe_get_dimensions(&pipe, &dev, input_width, input_height,
+                                  &pipe.processed_width, &pipe.processed_height);
+  const float scale = fminf(1.0f,
+                            fminf((float)maximum_dimension / pipe.processed_width,
+                                  (float)maximum_dimension / pipe.processed_height));
+  const int output_width = MAX(8, (int)floorf(scale * pipe.processed_width));
+  const int output_height = MAX(8, (int)floorf(scale * pipe.processed_height));
+  dt_dev_pixelpipe_process_no_gamma(&pipe, &dev, 0, 0,
+                                    output_width, output_height, scale);
+  if(!pipe.backbuf || pipe.backbuf_width < 8 || pipe.backbuf_height < 8)
+  {
+    status = -6;
+    goto cleanup_pipe;
+  }
+
+  const dt_film_analysis_config_t config = dt_film_analysis_default_config(stock);
+  status = dt_film_analyze_rgba_f32((const float *)pipe.backbuf,
+                                    pipe.backbuf_width, pipe.backbuf_height,
+                                    (size_t)pipe.backbuf_width * 4,
+                                    &config, result);
+
+cleanup_pipe:
+  dt_dev_pixelpipe_cleanup(&pipe);
+cleanup_buffer:
+  dt_mipmap_cache_release(&buffer);
+cleanup_dev:
+  dt_dev_cleanup(&dev);
+  /* Roll jobs are intentionally bounded-memory. The analysis result no longer
+   * needs this float preview, so don't retain a roll's worth of them. */
+  dt_mipmap_cache_evict_at_size(imgid, DT_MIPMAP_F);
+  return status;
+}
+
+int dt_film_write_roll_history(const dt_imgid_t imgid,
+                               const dt_film_stock_t stock,
+                               const dt_film_analysis_result_t *const frame,
+                               const dt_film_roll_analysis_result_t *const roll)
+{
+  if(!dt_is_valid_imgid(imgid) || !frame || !roll) return -1;
+  dt_film_analysis_result_t adjusted;
+  if(dt_film_apply_roll_baseline(frame, roll, &adjusted) != 0) return -2;
+
+  int status = 0;
+  dt_develop_t dev;
+  dt_dev_init(&dev, FALSE);
+  dt_dev_load_image(&dev, imgid);
+  dt_iop_module_t *const module = dt_iop_get_module_by_op_priority(dev.iop, "negadoctor", 0);
+  if(!module || module->version() != 2
+     || module->params_size != sizeof(dt_film_negadoctor_params_v2_t))
+  {
+    status = -3;
+    goto cleanup;
+  }
+
+  dt_film_negadoctor_params_v2_t *const params = module->params;
+  params->film_stock = stock == DT_FILM_STOCK_MONOCHROME ? 0 : 1;
+  if(stock == DT_FILM_STOCK_MONOCHROME)
+  {
+    const float neutral = (adjusted.film_base[0] + adjusted.film_base[1]
+                           + adjusted.film_base[2]) / 3.0f;
+    for(size_t channel = 0; channel < 3; channel++) params->Dmin[channel] = neutral;
+  }
+  else
+    for(size_t channel = 0; channel < 3; channel++)
+      params->Dmin[channel] = adjusted.film_base[channel];
+
+  for(size_t channel = 0; channel < 3; channel++)
+  {
+    params->Dmin[channel] = CLAMP(params->Dmin[channel], 0.00001f, 1.5f);
+    params->wb_high[channel] = CLAMP(adjusted.negadoctor_wb_high[channel], 0.25f, 2.0f);
+    params->wb_low[channel] = 1.0f;
+  }
+  params->Dmin[3] = params->wb_high[3] = params->wb_low[3] = 1.0f;
+  params->D_max = CLAMP(adjusted.negadoctor_dmax, 0.1f, 6.0f);
+  params->offset = CLAMP(adjusted.negadoctor_offset, -1.0f, 1.0f);
+
+  dt_dev_add_history_item_ext(&dev, module, TRUE, TRUE);
+  dt_dev_write_history_ext(&dev, imgid);
+
+cleanup:
+  dt_dev_cleanup(&dev);
+  return status;
+}
+
+// clang-format off
+// modelines: These editor modelines have been set for all relevant files by tools/update_modelines.py
+// vim: shiftwidth=2 expandtab tabstop=2 cindent
+// kate: tab-indents: off; indent-width 2; replace-tabs on; indent-mode cstyle; remove-trailing-spaces modified;
+// clang-format on
