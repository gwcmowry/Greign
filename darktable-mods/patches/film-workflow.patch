+    it under the terms of the GNU General Public License as published by
+    the Free Software Foundation, either version 3 of the License, or
+    (at your option) any later version.
+*/
+
+#include <setjmp.h>
+#include <stdarg.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+#include <cmocka.h>
+
+#include "common/film_roll_analysis.h"
+
+static dt_film_analysis_result_t _frame(const float base,
+                                        const float dmax,
+                                        const float confidence,
+                                        const uint32_t warnings)
+{
+  dt_film_analysis_result_t frame;
+  memset(&frame, 0, sizeof(frame));
+  frame.film_base[0] = base;
+  frame.film_base[1] = base * 0.65f;
+  frame.film_base[2] = base * 0.35f;
+  frame.film_base[3] = 1.0f;
+  frame.density_floor[0] = frame.density_floor[1] = frame.density_floor[2] = 0.1f;
+  frame.density_median[0] = frame.density_median[1] = frame.density_median[2] = 0.8f;
+  frame.density_ceiling[0] = frame.density_ceiling[1] = frame.density_ceiling[2] = 1.6f;
+  frame.negadoctor_dmax = dmax;
+  frame.negadoctor_wb_high[0] = frame.negadoctor_wb_high[1]
+    = frame.negadoctor_wb_high[2] = frame.negadoctor_wb_high[3] = 1.0f;
+  frame.confidence = confidence;
+  frame.warnings = warnings;
+  return frame;
+}
+
+static void test_explicit_reference_has_priority(void **state)
+{
+  (void)state;
+  const dt_film_analysis_result_t frames[] = { _frame(0.8f, 1.2f, 0.9f, 0) };
+  const float explicit_base[4] = { 0.95f, 0.62f, 0.33f, 1.0f };
+  dt_film_roll_analysis_result_t result;
+  assert_int_equal(dt_film_analyze_roll(frames, 1, explicit_base, NULL, &result), 0);
+  assert_int_equal(result.base_mode, DT_FILM_BASE_EXPLICIT_REFERENCE);
+  assert_float_equal(result.film_base[0], 0.95f, 1.0e-6f);
+  assert_float_equal(result.base_confidence, 1.0f, 1.0e-6f);
+}
+
+static void test_small_rebate_samples_are_enough(void **state)
+{
+  (void)state;
+  const dt_film_analysis_result_t frames[] = {
+    _frame(0.90f, 1.2f, 0.8f, 0),
+    _frame(0.92f, 1.4f, 0.9f, 0),
+    _frame(0.91f, 1.3f, 0.9f, DT_FILM_ANALYSIS_WARNING_NO_REBATE),
+  };
+  dt_film_roll_analysis_result_t result;
+  assert_int_equal(dt_film_analyze_roll(frames, 3, NULL, NULL, &result), 0);
+  assert_int_equal(result.base_mode, DT_FILM_BASE_MEASURED_REBATE);
+  assert_float_equal(result.film_base[0], 0.91f, 0.011f);
+  assert_true(result.base_confidence >= 0.8f);
+}
+
+static void test_roll_inference_needs_no_blank_frame(void **state)
+{
+  (void)state;
+  const dt_film_analysis_result_t frames[] = {
+    _frame(0.82f, 1.1f, 0.8f, DT_FILM_ANALYSIS_WARNING_NO_REBATE),
+    _frame(0.87f, 1.3f, 0.8f, DT_FILM_ANALYSIS_WARNING_NO_REBATE),
+    _frame(0.91f, 1.2f, 0.9f, DT_FILM_ANALYSIS_WARNING_NO_REBATE),
+    _frame(0.94f, 1.4f, 0.9f, DT_FILM_ANALYSIS_WARNING_NO_REBATE),
+  };
+  dt_film_roll_analysis_result_t result;
+  assert_int_equal(dt_film_analyze_roll(frames, 4, NULL, NULL, &result), 0);
+  assert_int_equal(result.base_mode, DT_FILM_BASE_INFERRED_ROLL);
+  assert_true(result.film_base[0] > 0.89f && result.film_base[0] < 0.94f);
+  assert_true(result.warnings & DT_FILM_ROLL_WARNING_BASE_INFERRED);
+}
+
+static void test_prior_and_single_frame_are_explicit_fallbacks(void **state)
+{
+  (void)state;
+  const dt_film_analysis_result_t frame =
+    _frame(0.72f, 1.1f, 0.8f, DT_FILM_ANALYSIS_WARNING_NO_REBATE);
+  const dt_film_base_prior_t prior = { .film_base = { 0.91f, 0.59f, 0.32f, 1.0f },
+                                       .confidence = 0.8f };
+  dt_film_roll_analysis_result_t result;
+  assert_int_equal(dt_film_analyze_roll(&frame, 1, NULL, &prior, &result), 0);
+  assert_int_equal(result.base_mode, DT_FILM_BASE_BORROWED_PRIOR);
+  assert_true(result.warnings & DT_FILM_ROLL_WARNING_BASE_BORROWED);
+
+  assert_int_equal(dt_film_analyze_roll(&frame, 1, NULL, NULL, &result), 0);
+  assert_int_equal(result.base_mode, DT_FILM_BASE_PER_FRAME_FALLBACK);
+  assert_true(result.warnings & DT_FILM_ROLL_WARNING_SINGLE_FRAME);
+}
+
+static void test_single_frame_fallback_skips_rejected_first_frame(void **state)
+{
+  (void)state;
+  const dt_film_analysis_result_t frames[] = {
+    _frame(0.99f, 1.0f, 0.1f, DT_FILM_ANALYSIS_WARNING_NO_REBATE),
+    _frame(0.72f, 1.1f, 0.8f, DT_FILM_ANALYSIS_WARNING_NO_REBATE),
+  };
+  dt_film_roll_analysis_result_t result;
+  assert_int_equal(dt_film_analyze_roll(frames, 2, NULL, NULL, &result), 0);
+  assert_int_equal(result.base_mode, DT_FILM_BASE_PER_FRAME_FALLBACK);
+  assert_float_equal(result.film_base[0], 0.72f, 1.0e-6f);
+  assert_int_equal(result.frames_rejected, 1);
+}
+
+static void test_roll_baseline_shares_range_but_keeps_frame_luma(void **state)
+{
+  (void)state;
+  dt_film_analysis_result_t frames[] = {
+    _frame(0.90f, 1.5f, 0.9f, 0),
+    _frame(0.92f, 1.5f, 0.9f, 0),
+  };
+  for(size_t channel = 0; channel < 3; channel++)
+  {
+    frames[1].density_floor[channel] += 0.2f;
+    frames[1].density_median[channel] += 0.2f;
+    frames[1].density_ceiling[channel] += 0.2f;
+  }
+  dt_film_roll_analysis_result_t roll;
+  assert_int_equal(dt_film_analyze_roll(frames, 2, NULL, NULL, &roll), 0);
+  dt_film_analysis_result_t light, dark;
+  assert_int_equal(dt_film_apply_roll_baseline(&frames[0], &roll, &light), 0);
+  assert_int_equal(dt_film_apply_roll_baseline(&frames[1], &roll, &dark), 0);
+  for(size_t channel = 0; channel < 3; channel++)
+    assert_float_equal(light.density_ceiling[channel] - light.density_floor[channel],
+                       dark.density_ceiling[channel] - dark.density_floor[channel], 1.0e-6f);
+  assert_true(dark.negadoctor_offset > light.negadoctor_offset);
+}
+
+int main(void)
+{
+  const struct CMUnitTest tests[] = {
+    cmocka_unit_test(test_explicit_reference_has_priority),
+    cmocka_unit_test(test_small_rebate_samples_are_enough),
+    cmocka_unit_test(test_roll_inference_needs_no_blank_frame),
+    cmocka_unit_test(test_prior_and_single_frame_are_explicit_fallbacks),
+    cmocka_unit_test(test_single_frame_fallback_skips_rejected_first_frame),
+    cmocka_unit_test(test_roll_baseline_shares_range_but_keeps_frame_luma),
+  };
+  return cmocka_run_group_tests(tests, NULL, NULL);
+}
+
+// clang-format off
+// modelines: These editor modelines have been set for all relevant files by tools/update_modelines.py
+// vim: shiftwidth=2 expandtab tabstop=2 cindent
+// kate: tab-indents: off; indent-width 2; replace-tabs on; indent-mode cstyle; remove-trailing-spaces modified;
+// clang-format on
