+#include "common/film_roll_analysis.h"
+
+/* Render a bounded linear-working-RGB proxy up to Negadoctor's input and
+ * analyze it. Existing upstream edits and geometry are respected. */
+int dt_film_analyze_image_proxy(dt_imgid_t imgid,
+                                dt_film_stock_t stock,
+                                int maximum_dimension,
+                                dt_film_analysis_result_t *result);
+
