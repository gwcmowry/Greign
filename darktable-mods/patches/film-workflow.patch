index 0000000..13f862a
--- /dev/null
+++ b/src/common/film_roll_analysis.c
@@ -0,0 +1,239 @@
+/*
+    This file is part of darktable,
+    Copyright (C) 2026 darktable developers.
+
+    darktable is free software: you can redistribute it and/or modify
+    it under the terms of the GNU General Public License as published by
+    the Free Software Foundation, either version 3 of the License, or
+    (at your option) any later version.
+*/
+
+#include "common/film_roll_analysis.h"
+
+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+
+static int _compare_float(const void *const left, const void *const right)
+{
+  const float a = *(const float *)left;
+  const float b = *(const float *)right;
+  return (a > b) - (a < b);
+}
+
+static float _quantile(float *const values, const size_t count, const float percentile)
+{
+  if(count == 0) return 0.0f;
+  qsort(values, count, sizeof(float), _compare_float);
+  const float position = fmaxf(0.0f, fminf(1.0f, percentile)) * (float)(count - 1);
+  const size_t low = (size_t)floorf(position);
+  const size_t high = (size_t)ceilf(position);
+  const float fraction = position - (float)low;
+  return values[low] * (1.0f - fraction) + values[high] * fraction;
+}
+
+static int _valid_base(const float base[4])
+{
+  if(!base) return 0;
+  for(size_t channel = 0; channel < 3; channel++)
+    if(!isfinite(base[channel]) || base[channel] <= 0.0f) return 0;
+  return 1;
+}
+
+int dt_film_analyze_roll(const dt_film_analysis_result_t *const frames,
+                         const size_t frame_count,
+                         const float explicit_base[4],
+                         const dt_film_base_prior_t *const borrowed_prior,
+                         dt_film_roll_analysis_result_t *const result)
+{
+  if(!frames || frame_count == 0 || !result) return -1;
+  memset(result, 0, sizeof(*result));
+  result->frame_count = frame_count;
+  result->film_base[3] = 1.0f;
+  result->negadoctor_wb_high[3] = 1.0f;
+
+  size_t accepted_count = 0;
+  size_t measured_count = 0;
+  size_t first_accepted = frame_count;
+  for(size_t index = 0; index < frame_count; index++)
+  {
+    const int rejected = frames[index].confidence < 0.2f
+                         || (frames[index].warnings & DT_FILM_ANALYSIS_WARNING_CLIPPED_BASE);
+    if(rejected)
+      result->frames_rejected++;
+    else
+    {
+      if(first_accepted == frame_count) first_accepted = index;
+      accepted_count++;
+      if(!(frames[index].warnings & (DT_FILM_ANALYSIS_WARNING_NO_REBATE
+                                     | DT_FILM_ANALYSIS_WARNING_NONUNIFORM_REBATE)))
+        measured_count++;
+    }
+  }
+  if(accepted_count == 0) return -2;
+  result->frames_used = accepted_count;
+  if(result->frames_rejected > 0) result->warnings |= DT_FILM_ROLL_WARNING_REJECTED_FRAMES;
+
+  float *const scratch = malloc(frame_count * sizeof(float));
+  if(!scratch) return -3;
+
+  if(_valid_base(explicit_base))
+  {
+    result->base_mode = DT_FILM_BASE_EXPLICIT_REFERENCE;
+    memcpy(result->film_base, explicit_base, 3 * sizeof(float));
+    result->base_confidence = 1.0f;
+  }
+  else if(measured_count > 0)
+  {
+    result->base_mode = DT_FILM_BASE_MEASURED_REBATE;
+    for(size_t channel = 0; channel < 3; channel++)
+    {
+      size_t count = 0;
+      for(size_t index = 0; index < frame_count; index++)
+        if(frames[index].confidence >= 0.2f
+           && !(frames[index].warnings & (DT_FILM_ANALYSIS_WARNING_NO_REBATE
+                                          | DT_FILM_ANALYSIS_WARNING_NONUNIFORM_REBATE
+                                          | DT_FILM_ANALYSIS_WARNING_CLIPPED_BASE)))
+          scratch[count++] = frames[index].film_base[channel];
+      result->film_base[channel] = _quantile(scratch, count, 0.5f);
+    }
+    result->base_confidence = fminf(0.95f, 0.7f + 0.05f * (float)measured_count);
+  }
+  else if(accepted_count >= 3)
+  {
+    result->base_mode = DT_FILM_BASE_INFERRED_ROLL;
+    result->warnings |= DT_FILM_ROLL_WARNING_BASE_INFERRED;
+    for(size_t channel = 0; channel < 3; channel++)
+    {
+      size_t count = 0;
+      for(size_t index = 0; index < frame_count; index++)
+        if(frames[index].confidence >= 0.2f
+           && !(frames[index].warnings & DT_FILM_ANALYSIS_WARNING_CLIPPED_BASE))
+          scratch[count++] = frames[index].film_base[channel];
+      /* Film base is an upper transmission envelope; use the robust upper
+       * quartile across frames rather than requiring a blank frame. */
+      result->film_base[channel] = _quantile(scratch, count, 0.75f);
+    }
+    result->base_confidence = fminf(0.85f, 0.45f + 0.05f * (float)accepted_count);
+  }
+  else if(borrowed_prior && _valid_base(borrowed_prior->film_base))
+  {
+    result->base_mode = DT_FILM_BASE_BORROWED_PRIOR;
+    result->warnings |= DT_FILM_ROLL_WARNING_BASE_BORROWED;
+    memcpy(result->film_base, borrowed_prior->film_base, 3 * sizeof(float));
+    result->base_confidence = fminf(fmaxf(borrowed_prior->confidence, 0.0f), 0.65f);
+  }
+  else
+  {
+    result->base_mode = DT_FILM_BASE_PER_FRAME_FALLBACK;
+    result->warnings |= DT_FILM_ROLL_WARNING_SINGLE_FRAME;
+    memcpy(result->film_base, frames[first_accepted].film_base, 3 * sizeof(float));
+    result->base_confidence = fminf(frames[first_accepted].confidence, 0.4f);
+  }
+
+  for(size_t channel = 0; channel < 3; channel++)
+  {
+    size_t count = 0;
+    for(size_t index = 0; index < frame_count; index++)
+      if(frames[index].confidence >= 0.2f
+         && !(frames[index].warnings & DT_FILM_ANALYSIS_WARNING_CLIPPED_BASE))
+        scratch[count++] = frames[index].density_floor[channel];
+    result->density_floor[channel] = _quantile(scratch, count, 0.5f);
+
+    count = 0;
+    for(size_t index = 0; index < frame_count; index++)
+      if(frames[index].confidence >= 0.2f
+         && !(frames[index].warnings & DT_FILM_ANALYSIS_WARNING_CLIPPED_BASE))
+        scratch[count++] = frames[index].density_median[channel];
+    result->density_median[channel] = _quantile(scratch, count, 0.5f);
+
+    count = 0;
+    for(size_t index = 0; index < frame_count; index++)
+      if(frames[index].confidence >= 0.2f
+         && !(frames[index].warnings & DT_FILM_ANALYSIS_WARNING_CLIPPED_BASE))
+        scratch[count++] = frames[index].density_ceiling[channel];
+    result->density_ceiling[channel] = _quantile(scratch, count, 0.5f);
+
+    count = 0;
+    for(size_t index = 0; index < frame_count; index++)
+      if(frames[index].confidence >= 0.2f
+         && !(frames[index].warnings & DT_FILM_ANALYSIS_WARNING_CLIPPED_BASE))
+        scratch[count++] = frames[index].negadoctor_wb_high[channel];
+    result->negadoctor_wb_high[channel] = _quantile(scratch, count, 0.5f);
+  }
+
+  size_t dmax_count = 0;
+  for(size_t index = 0; index < frame_count; index++)
+    if(frames[index].confidence >= 0.2f
+       && !(frames[index].warnings & DT_FILM_ANALYSIS_WARNING_CLIPPED_BASE))
+      scratch[dmax_count++] = frames[index].negadoctor_dmax;
+  result->negadoctor_dmax = _quantile(scratch, dmax_count, 0.5f);
+
+  const float coverage = (float)accepted_count / (float)frame_count;
+  result->roll_confidence = result->base_confidence * (0.6f + 0.4f * coverage);
+  free(scratch);
+  return 0;
+}
+
+int dt_film_apply_roll_baseline(const dt_film_analysis_result_t *const frame,
+                                const dt_film_roll_analysis_result_t *const roll,
+                                dt_film_analysis_result_t *const result)
+{
+  if(!frame || !roll || !result || !_valid_base(frame->film_base)
+     || !_valid_base(roll->film_base))
+    return -1;
+
+  dt_film_analysis_result_t adjusted = *frame;
+  float shifted_floor_mean = 0.0f;
+  float shifted_median_mean = 0.0f;
+  float roll_floor_mean = 0.0f;
+  float roll_median_mean = 0.0f;
+  float ranges[3];
+  for(size_t channel = 0; channel < 3; channel++)
+  {
+    const float base_shift = log10f(roll->film_base[channel]
+                                     / fmaxf(frame->film_base[channel], 1.0e-8f));
+    shifted_floor_mean += frame->density_floor[channel] + base_shift;
+    shifted_median_mean += frame->density_median[channel] + base_shift;
+    roll_floor_mean += roll->density_floor[channel];
+    roll_median_mean += roll->density_median[channel];
+    ranges[channel] = fmaxf(roll->density_ceiling[channel]
+                             - roll->density_floor[channel], 0.1f);
+  }
+  shifted_floor_mean /= 3.0f;
+  shifted_median_mean /= 3.0f;
+  roll_floor_mean /= 3.0f;
+  roll_median_mean /= 3.0f;
+
+  float dmax = 0.0f;
+  for(size_t channel = 0; channel < 3; channel++)
+  {
+    adjusted.film_base[channel] = roll->film_base[channel];
+    adjusted.density_floor[channel] = shifted_floor_mean
+                                      + roll->density_floor[channel] - roll_floor_mean;
+    adjusted.density_median[channel] = shifted_median_mean
+                                       + roll->density_median[channel] - roll_median_mean;
+    adjusted.density_ceiling[channel] = adjusted.density_floor[channel] + ranges[channel];
+    dmax += ranges[channel];
+  }
+  adjusted.film_base[3] = 1.0f;
+  dmax /= 3.0f;
+  adjusted.negadoctor_dmax = dmax;
+  float floor_mean = 0.0f;
+  for(size_t channel = 0; channel < 3; channel++)
+  {
+    adjusted.negadoctor_wb_high[channel] = dmax / ranges[channel];
+    floor_mean += adjusted.density_floor[channel];
+  }
+  adjusted.negadoctor_wb_high[3] = 1.0f;
+  adjusted.negadoctor_offset = floor_mean / 3.0f / fmaxf(dmax, 0.1f);
+  adjusted.confidence = fminf(frame->confidence, roll->roll_confidence);
+  *result = adjusted;
+  return 0;
+}
+
+// clang-format off
+// modelines: These editor modelines have been set for all relevant files by tools/update_modelines.py
+// vim: shiftwidth=2 expandtab tabstop=2 cindent
+// kate: tab-indents: off; indent-width 2; replace-tabs on; indent-mode cstyle; remove-trailing-spaces modified;
+// clang-format on
