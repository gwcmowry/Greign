+static void _auto_analyze_callback(GtkButton *button, dt_iop_module_t *self)
+{
+  DT_GUARD_GUI_UPDATE();
+  dt_iop_negadoctor_gui_data_t *const g = self->gui_data;
+  dt_iop_negadoctor_params_t *const p = self->params;
+  dt_film_analysis_result_t analysis;
+
+  g_mutex_lock(&g->analysis_lock);
+  const gboolean valid = g->analysis_valid
+                         && g->analysis_imgid == self->dev->image_storage.id;
+  analysis = g->analysis;
+  g_mutex_unlock(&g->analysis_lock);
+  if(!valid)
+  {
+    gtk_label_set_text(GTK_LABEL(g->auto_status), _("waiting for this image's preview"));
+    return;
+  }
+
+  if(analysis.warnings & DT_FILM_ANALYSIS_WARNING_CLIPPED_BASE)
+  {
+    gtk_label_set_text(GTK_LABEL(g->auto_status),
+                       _("not applied: film base reaches the scanner ceiling"));
+    dt_control_log(_("film analysis was not applied because the film base is clipped"));
+    return;
+  }
+
+  if(p->film_stock == DT_FILMSTOCK_COLOR)
+  {
+    for(size_t channel = 0; channel < 3; channel++)
+      p->Dmin[channel] = CLAMP(analysis.film_base[channel], 0.00001f, 1.5f);
+  }
+  else
+  {
+    const float neutral_base = (analysis.film_base[0]
+                                + analysis.film_base[1]
+                                + analysis.film_base[2]) / 3.0f;
+    for(size_t channel = 0; channel < 3; channel++)
+      p->Dmin[channel] = CLAMP(neutral_base, 0.00001f, 1.5f);
+  }
+  p->Dmin[3] = 1.0f;
+  for(size_t channel = 0; channel < 3; channel++)
+  {
+    p->wb_high[channel] = CLAMP(analysis.negadoctor_wb_high[channel], 0.25f, 2.0f);
+    p->wb_low[channel] = 1.0f;
+  }
+  p->wb_high[3] = p->wb_low[3] = 1.0f;
+  p->D_max = CLAMP(analysis.negadoctor_dmax, 0.1f, 6.0f);
+  p->offset = CLAMP(analysis.negadoctor_offset, -1.0f, 1.0f);
+
+  DT_ENTER_GUI_UPDATE();
+  dt_bauhaus_slider_set(g->Dmin_R, p->Dmin[0]);
+  dt_bauhaus_slider_set(g->Dmin_G, p->Dmin[1]);
+  dt_bauhaus_slider_set(g->Dmin_B, p->Dmin[2]);
+  dt_bauhaus_slider_set(g->D_max, p->D_max);
+  dt_bauhaus_slider_set(g->offset, p->offset);
+  dt_bauhaus_slider_set(g->wb_high_R, p->wb_high[0]);
+  dt_bauhaus_slider_set(g->wb_high_G, p->wb_high[1]);
+  dt_bauhaus_slider_set(g->wb_high_B, p->wb_high[2]);
+  dt_bauhaus_slider_set(g->wb_low_R, p->wb_low[0]);
+  dt_bauhaus_slider_set(g->wb_low_G, p->wb_low[1]);
+  dt_bauhaus_slider_set(g->wb_low_B, p->wb_low[2]);
+  DT_LEAVE_GUI_UPDATE();
+
+  Dmin_picker_update(self);
+  WB_high_picker_update(self);
+  WB_low_picker_update(self);
+
+  gchar *const status = g_strdup_printf(
+    analysis.warnings & (DT_FILM_ANALYSIS_WARNING_NO_REBATE
+                         | DT_FILM_ANALYSIS_WARNING_NONUNIFORM_REBATE)
+      ? _("applied with %.0f%% confidence · film base inferred from frame")
+      : _("applied with %.0f%% confidence · film base measured from border"),
+    analysis.confidence * 100.0f);
+  gtk_label_set_text(GTK_LABEL(g->auto_status), status);
+  g_free(status);
+
+  dt_control_queue_redraw_widget(self->widget);
+  dt_dev_add_history_item(self->dev, self, TRUE);
+}
