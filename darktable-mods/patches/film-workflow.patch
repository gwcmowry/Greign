+typedef enum dt_film_stock_t
+{
+  DT_FILM_STOCK_MONOCHROME = 0,
+  DT_FILM_STOCK_COLOR = 1
+} dt_film_stock_t;
+
+typedef enum dt_film_analysis_warning_t
+{
+  DT_FILM_ANALYSIS_WARNING_NONE = 0,
+  DT_FILM_ANALYSIS_WARNING_NO_REBATE = 1u << 0,
+  DT_FILM_ANALYSIS_WARNING_LOW_RANGE = 1u << 1,
+  DT_FILM_ANALYSIS_WARNING_CLIPPED_BASE = 1u << 2,
+  DT_FILM_ANALYSIS_WARNING_NONUNIFORM_REBATE = 1u << 3
+} dt_film_analysis_warning_t;
+
+typedef struct dt_film_analysis_config_t
+{
+  dt_film_stock_t stock;
+  float border_fraction;
+  float base_percentile;
+  float density_floor_percentile;
+  float density_ceiling_percentile;
+  float maximum_density;
+  /* Set only when the caller knows the linear buffer's clipping ceiling.
+   * Zero means unbounded/unknown, as in darktable's working RGB pipeline. */
+  float input_ceiling;
+  size_t sample_limit;
+} dt_film_analysis_config_t;
+
+typedef struct dt_film_analysis_result_t
+{
+  float film_base[4];
+  float density_floor[4];
+  float density_median[4];
+  float density_ceiling[4];
+
+  /* Parameters map directly onto negadoctor's technical controls. */
+  float negadoctor_dmax;
+  float negadoctor_offset;
+  float negadoctor_wb_high[4];
+
+  float confidence;
+  size_t sampled_pixels;
+  size_t sampled_border_pixels;
+  uint32_t warnings;
+} dt_film_analysis_result_t;
+
+dt_film_analysis_config_t dt_film_analysis_default_config(dt_film_stock_t stock);
+
+/*
+ * Analyze non-negative, scene-linear RGB pixels. `row_stride` is measured in
+ * floats and pixels are RGB-interleaved. The image is never retained.
+ *
+ * Returns zero on success and a negative value for invalid input or an image
+ * without enough usable samples.
+ */
+int dt_film_analyze_rgb_f32(const float *rgb,
+                            size_t width,
+                            size_t height,
+                            size_t row_stride,
+                            const dt_film_analysis_config_t *config,
+                            dt_film_analysis_result_t *result);
+
+/* Analyze darktable's native four-channel float pixel buffers without making
+ * a temporary RGB copy. The alpha channel is ignored. */
+int dt_film_analyze_rgba_f32(const float *rgba,
+                             size_t width,
+                             size_t height,
+                             size_t row_stride,
+                             const dt_film_analysis_config_t *config,
+                             dt_film_analysis_result_t *result);
+
+/*
+ * Small CPU reference for the automatically-derived negadoctor technical
+ * parameters. Creative paper controls intentionally stay outside analysis.
+ */
+void dt_film_apply_auto_negadoctor_pixel(const float input[3],
+                                         const dt_film_analysis_result_t *analysis,
+                                         float output[3]);
