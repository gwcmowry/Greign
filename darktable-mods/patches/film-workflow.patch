+#include <cmocka.h>
+#include <math.h>
+
+#include "common/film_analysis.h"
+
+static float *_synthetic_negative(const size_t width, const size_t height, const float base[3])
+{
+  float *const pixels = calloc(width * height * 3, sizeof(float));
+  assert_non_null(pixels);
+  for(size_t y = 0; y < height; y++)
+  {
+    for(size_t x = 0; x < width; x++)
+    {
+      const int border = x < 10 || x >= width - 10 || y < 10 || y >= height - 10;
+      const float density = border ? 0.0f : 0.1f + 1.7f * (float)(x - 10) / (float)(width - 21);
+      for(size_t channel = 0; channel < 3; channel++)
+        pixels[3 * (y * width + x) + channel] = base[channel] * powf(10.0f, -density);
+    }
+  }
+  return pixels;
+}
+
+static void test_color_analysis_derives_negadoctor_parameters(void **state)
+{
+  (void)state;
+  const size_t width = 160, height = 100;
+  const float base[3] = { 1.0f, 0.62f, 0.31f };
+  float *const pixels = _synthetic_negative(width, height, base);
+  dt_film_analysis_config_t config = dt_film_analysis_default_config(DT_FILM_STOCK_COLOR);
+  config.input_ceiling = 1.0f;
+  dt_film_analysis_result_t result;
+
+  assert_int_equal(dt_film_analyze_rgb_f32(pixels, width, height, width * 3, &config, &result), 0);
+  assert_float_equal(result.film_base[0], base[0], 0.002f);
+  assert_float_equal(result.film_base[1], base[1], 0.002f);
+  assert_float_equal(result.film_base[2], base[2], 0.002f);
+  assert_true(result.negadoctor_dmax > 1.5f);
+  assert_true(result.negadoctor_dmax < 1.9f);
+  assert_true(result.confidence > 0.5f);
+  assert_true(result.warnings & DT_FILM_ANALYSIS_WARNING_CLIPPED_BASE);
+
+  const float thin[3] = { base[0], base[1], base[2] };
+  const float dense[3] = { base[0] * 0.02f, base[1] * 0.02f, base[2] * 0.02f };
+  float thin_positive[3], dense_positive[3];
+  dt_film_apply_auto_negadoctor_pixel(thin, &result, thin_positive);
+  dt_film_apply_auto_negadoctor_pixel(dense, &result, dense_positive);
+  assert_true(thin_positive[0] < dense_positive[0]);
+  assert_true(dense_positive[0] > 0.8f);
+  free(pixels);
+}
+
+static void test_monochrome_analysis_preserves_scanner_channel_baselines(void **state)
+{
+  (void)state;
+  const size_t width = 160, height = 100;
+  const float base[3] = { 0.91f, 0.72f, 0.54f };
+  float *const pixels = _synthetic_negative(width, height, base);
+  const dt_film_analysis_config_t config = dt_film_analysis_default_config(DT_FILM_STOCK_MONOCHROME);
+  dt_film_analysis_result_t result;
+
+  assert_int_equal(dt_film_analyze_rgb_f32(pixels, width, height, width * 3, &config, &result), 0);
+  assert_float_equal(result.film_base[0], base[0], 0.002f);
+  assert_float_equal(result.film_base[1], base[1], 0.002f);
+  assert_float_equal(result.film_base[2], base[2], 0.002f);
+  assert_false(result.warnings & DT_FILM_ANALYSIS_WARNING_CLIPPED_BASE);
+  free(pixels);
+}
+
+static void test_invalid_input_is_rejected(void **state)
+{
+  (void)state;
+  const dt_film_analysis_config_t config = dt_film_analysis_default_config(DT_FILM_STOCK_COLOR);
+  dt_film_analysis_result_t result;
+  assert_true(dt_film_analyze_rgb_f32(NULL, 10, 10, 30, &config, &result) < 0);
+  assert_true(dt_film_analyze_rgb_f32((const float[3]){ 1.0f, 1.0f, 1.0f },
+                                      1, 1, 3, &config, &result) < 0);
+}
+
+static void test_rgba_analysis_matches_rgb_and_ignores_alpha(void **state)
+{
+  (void)state;
+  const size_t width = 160, height = 100;
+  const float base[3] = { 0.92f, 0.61f, 0.33f };
+  float *const rgb = _synthetic_negative(width, height, base);
+  float *const rgba = calloc(width * height * 4, sizeof(float));
+  assert_non_null(rgba);
+  for(size_t pixel = 0; pixel < width * height; pixel++)
+  {
+    memcpy(rgba + 4 * pixel, rgb + 3 * pixel, 3 * sizeof(float));
+    rgba[4 * pixel + 3] = pixel % 2 ? -1000.0f : 1000.0f;
+  }
+
+  const dt_film_analysis_config_t config = dt_film_analysis_default_config(DT_FILM_STOCK_COLOR);
+  dt_film_analysis_result_t rgb_result, rgba_result;
+  assert_int_equal(dt_film_analyze_rgb_f32(rgb, width, height, width * 3,
+                                            &config, &rgb_result), 0);
+  assert_int_equal(dt_film_analyze_rgba_f32(rgba, width, height, width * 4,
+                                             &config, &rgba_result), 0);
+  assert_memory_equal(rgb_result.film_base, rgba_result.film_base,
+                      sizeof(rgb_result.film_base));
+  assert_float_equal(rgb_result.negadoctor_dmax, rgba_result.negadoctor_dmax, 1.0e-7f);
+  assert_float_equal(rgb_result.negadoctor_offset, rgba_result.negadoctor_offset, 1.0e-7f);
+
+  free(rgba);
+  free(rgb);
+}
+
+static void test_nonuniform_border_is_not_accepted_as_clean_rebate(void **state)
+{
+  (void)state;
+  const size_t width = 160, height = 100;
+  const float base[3] = { 0.92f, 0.61f, 0.33f };
+  float *const pixels = _synthetic_negative(width, height, base);
+  for(size_t y = 0; y < 10; y++)
+    for(size_t x = 0; x < width / 2; x++)
+      for(size_t channel = 0; channel < 3; channel++)
+        pixels[3 * (y * width + x) + channel] *= 0.05f;
+
+  const dt_film_analysis_config_t config = dt_film_analysis_default_config(DT_FILM_STOCK_COLOR);
+  dt_film_analysis_result_t result;
+  assert_int_equal(dt_film_analyze_rgb_f32(pixels, width, height, width * 3,
+                                            &config, &result), 0);
+  assert_true(result.warnings & DT_FILM_ANALYSIS_WARNING_NONUNIFORM_REBATE);
+  free(pixels);
+}
+
+static void test_unbounded_working_rgb_above_one_is_not_called_clipped(void **state)
+{
+  (void)state;
+  const size_t width = 160, height = 100;
+  const float base[3] = { 1.20f, 0.82f, 0.48f };
+  float *const pixels = _synthetic_negative(width, height, base);
+  const dt_film_analysis_config_t config = dt_film_analysis_default_config(DT_FILM_STOCK_COLOR);
+  dt_film_analysis_result_t result;
+  assert_int_equal(dt_film_analyze_rgb_f32(pixels, width, height, width * 3,
+                                            &config, &result), 0);
+  assert_false(result.warnings & DT_FILM_ANALYSIS_WARNING_CLIPPED_BASE);
+  assert_float_equal(result.film_base[0], base[0], 0.003f);
+  free(pixels);
+}
+
+int main(void)
+{
+  const struct CMUnitTest tests[] = {
+    cmocka_unit_test(test_color_analysis_derives_negadoctor_parameters),
+    cmocka_unit_test(test_monochrome_analysis_preserves_scanner_channel_baselines),
+    cmocka_unit_test(test_invalid_input_is_rejected),
+    cmocka_unit_test(test_rgba_analysis_matches_rgb_and_ignores_alpha),
+    cmocka_unit_test(test_nonuniform_border_is_not_accepted_as_clean_rebate),
+    cmocka_unit_test(test_unbounded_working_rgb_above_one_is_not_called_clipped),
+  };
+  return cmocka_run_group_tests(tests, NULL, NULL);
+}
