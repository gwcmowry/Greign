index 0000000..4c82a08
--- /dev/null
+++ b/src/cli/film_roll.c
@@ -0,0 +1,127 @@
+/* Development benchmark and headless integration harness for film-roll analysis. */
+
+#include "common/darktable.h"
+#include "common/database.h"
+#include "common/debug.h"
+#include "common/film.h"
+#include "common/film_roll_workflow.h"
+#include "common/image.h"
+
+#include <gtk/gtk.h>
+#include <stdio.h>
+#include <string.h>
+
+static void usage(const char *const program)
+{
+  fprintf(stderr, "usage: %s [--monochrome] RAW [RAW ...]\n", program);
+}
+
+int main(int argc, char **argv)
+{
+  if(!gtk_parse_args(&argc, &argv)) return 1;
+  dt_film_stock_t stock = DT_FILM_STOCK_COLOR;
+  int first_input = 1;
+  if(argc > 1 && !strcmp(argv[1], "--monochrome"))
+  {
+    stock = DT_FILM_STOCK_MONOCHROME;
+    first_input++;
+  }
+  if(argc <= first_input)
+  {
+    usage(argv[0]);
+    return 1;
+  }
+
+  char *core_argv[] = {
+    "darktable-film-roll-cli",
+    "--library", ":memory:",
+    "--conf", "write_sidecar_files=never",
+    "--disable-opencl",
+    NULL,
+  };
+  if(dt_init(6, core_argv, FALSE, FALSE, NULL)) return 1;
+
+  const size_t requested = (size_t)(argc - first_input);
+  dt_imgid_t *const ids = g_new0(dt_imgid_t, requested);
+  dt_film_analysis_result_t *const frames = g_new0(dt_film_analysis_result_t, requested);
+  size_t analyzed = 0;
+  const double started = dt_get_wtime();
+  for(int arg = first_input; arg < argc; arg++)
+  {
+    gchar *const directory = g_path_get_dirname(argv[arg]);
+    dt_film_t film;
+    const dt_filmid_t filmid = dt_film_new(&film, directory);
+    g_free(directory);
+    if(!dt_is_valid_filmid(filmid)) continue;
+    const dt_imgid_t imgid = dt_image_import(filmid, argv[arg], TRUE, FALSE);
+    if(!dt_is_valid_imgid(imgid)) continue;
+
+    const double frame_started = dt_get_wtime();
+    if(dt_film_analyze_image_proxy(imgid, stock, 1600, &frames[analyzed]) == 0)
+    {
+      ids[analyzed++] = imgid;
+      fprintf(stderr, "frame %zu analysis %.6f s\n", analyzed,
+              dt_get_wtime() - frame_started);
+    }
+  }
+  const double analysis_seconds = dt_get_wtime() - started;
+
+  dt_film_roll_analysis_result_t roll;
+  int status = analyzed == 0 ? 1 : dt_film_analyze_roll(frames, analyzed, NULL, NULL, &roll);
+  const double history_started = dt_get_wtime();
+  size_t written = 0;
+  if(status == 0)
+    for(size_t frame = 0; frame < analyzed; frame++)
+    {
+      const double frame_started = dt_get_wtime();
+      if(dt_film_write_roll_history(ids[frame], stock, &frames[frame], &roll) == 0)
+        written++;
+      fprintf(stderr, "frame %zu history %.6f s\n", frame + 1,
+              dt_get_wtime() - frame_started);
+    }
+  const double history_seconds = dt_get_wtime() - history_started;
+  const double total_seconds = dt_get_wtime() - started;
+
+  size_t verified = 0;
+  sqlite3_stmt *statement = NULL;
+  DT_DEBUG_SQLITE3_PREPARE_V2(
+    dt_database_get(darktable.db),
+    "SELECT COUNT(*) FROM main.history"
+    " WHERE imgid=?1 AND operation='negadoctor' AND enabled=1"
+    " AND length(op_params)=76",
+    -1, &statement, NULL);
+  for(size_t frame = 0; frame < analyzed; frame++)
+  {
+    DT_DEBUG_SQLITE3_BIND_INT(statement, 1, ids[frame]);
+    if(sqlite3_step(statement) == SQLITE_ROW && sqlite3_column_int(statement, 0) > 0)
+      verified++;
+    sqlite3_reset(statement);
+  }
+  sqlite3_finalize(statement);
+
+  printf("{\n"
+         "  \"requested\": %zu,\n"
+         "  \"analyzed\": %zu,\n"
+         "  \"histories_written\": %zu,\n"
+         "  \"histories_verified\": %zu,\n"
+         "  \"base_mode\": %d,\n"
+         "  \"analysis_seconds\": %.6f,\n"
+         "  \"history_seconds\": %.6f,\n"
+         "  \"total_seconds\": %.6f,\n"
+         "  \"seconds_per_image\": %.6f\n"
+         "}\n",
+         requested, analyzed, written, verified, status == 0 ? roll.base_mode : -1,
+         analysis_seconds, history_seconds, total_seconds,
+         analyzed ? total_seconds / analyzed : 0.0);
+
+  g_free(frames);
+  g_free(ids);
+  dt_cleanup();
+  return status == 0 && written == analyzed && verified == written ? 0 : 1;
+}
+
